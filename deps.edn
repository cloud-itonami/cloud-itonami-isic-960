{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root path only resolves
 ;; inside the monorepo checkout -- a standalone fork should override it
 ;; with git coordinates (see `io.github.kotoba-lang/langgraph`'s own
 ;; `deps.edn`, which pins `langchain` via `:git/sha` for exactly this
 ;; reason). Same pattern as cloud-itonami-isic-869 / cloud-itonami-isic-932.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "personalcareops.sim"]}
  ;; clojure -M:dev:render-html [out-file]
  ;;   -> RUN the real compiled StateGraph over the real seed data and write
  ;;      docs/samples/operator-console.html from the actual run output.
  ;;      Nothing on that page is authored by hand: every entity, id, status,
  ;;      verdict and count is read back out of the run's state / the store's
  ;;      ledger / the store's coordination-log. `-main` THROWS and writes no
  ;;      file if the run produced zero HARD governor holds.
  ;;
  ;;      jp-go-dds (デジタル庁デザインシステム) is a BUILD-TIME dep only --
  ;;      kept out of the base :deps so the repo stays standalone-forkable and
  ;;      so `:run`/`:test` do not pull a design system they never use.
  :render-html {:extra-deps
                {io.github.kotoba-lang/jp-go-digital-design-system
                 {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
                  :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}}
                :main-opts ["-m" "personalcareops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
