{:module-id :cloud-itonami-isic-960
 :isic-code "960"
 :title "Personal-Care Salon/Service Administrative Coordination"
 :description "Autonomous actor for back-office coordination of personal-care salons and services (hairdressing, beauty treatments, laundry, funeral services, etc.). Administrative logistics only: appointment scheduling, service-status updates, supply coordination, staff shifts, and safety escalation."

 :operations
 [{:operation-id :schedule-service-appointment
   :title "Schedule Service Appointment"
   :description "Appointment scheduling logistics (administrative only)"
   :scope "Administrative coordination, no clinical input"
   :phase-0-auto-commit? false
   :phase-1-auto-commit? true
   :phase-3-auto-commit? true}

  {:operation-id :coordinate-service-status-update
   :title "Coordinate Service Status Update"
   :description "Administrative status tracking (administrative only)"
   :scope "Admin-level status tracking, no clinical decisions"
   :phase-0-auto-commit? false
   :phase-1-auto-commit? true
   :phase-3-auto-commit? true}

  {:operation-id :coordinate-supply-request
   :title "Coordinate Supply Request"
   :description "Non-service-critical consumables (office supplies, etc.)"
   :scope "Office/administrative supplies only, not clinical/treatment products"
   :phase-0-auto-commit? false
   :phase-2-auto-commit? true
   :phase-3-auto-commit? true}

  {:operation-id :schedule-staff-shift-proposal
   :title "Schedule Staff Shift Proposal"
   :description "Administrative shift proposal (proposal only, not binding)"
   :scope "Administrative scheduling, no staff qualification/assignment decisions"
   :phase-0-auto-commit? false
   :phase-2-auto-commit? true
   :phase-3-auto-commit? true}

  {:operation-id :flag-safety-concern
   :title "Flag Safety Concern"
   :description "Facility/sanitation/client-welfare safety escalation"
   :scope "Facility hazards, sanitation issues, client-welfare concerns for human review"
   :always-escalates? true
   :phase-0-auto-commit? false
   :phase-3-auto-commit? false}]

 :hard-governor-checks
 [{:check-id :client-unverified
   :title "Client Verification"
   :rule "Target client must exist in store AND be :registered? AND :verified?"
   :permanent? true}

  {:check-id :effect-not-propose
   :title "Effect Validation"
   :rule "Effect must be :propose, no other values accepted"
   :permanent? true}

  {:check-id :scope-exclusion
   :title "Scope Exclusion"
   :rule "Blocked: service-technique, clinical/health judgments, safety-authority. Allowed: administrative coordination only."
   :permanent? true}]

 :scope-exclusions
 [{:category "service-technique"
   :examples ["treatment-plan" "product-selection" "service-method"]
   :en-patterns [#"(?i)treatment.*plan" #"(?i)service.*technique" #"(?i)product.*selection"]
   :ja-patterns [#"施術.?方法" #"治療.?計画" #"製品.?選択"]
   :blocked? true}

  {:category "clinical-health-judgments"
   :examples ["allergy-risk" "health-condition" "medication-prescription"]
   :en-patterns [#"(?i)allergy.*risk" #"(?i)health.*condition" #"(?i)medication.*prescription"]
   :ja-patterns [#"アレルギー.?リスク" #"健康.?診断" #"薬剤.?処方"]
   :blocked? true}

  {:category "safety-authority-overrides"
   :examples ["sanitation-certification" "safety-authority" "compliance-override"]
   :en-patterns [#"(?i)sanitation.*certification" #"(?i)safety.*authority" #"(?i)compliance.*override"]
   :ja-patterns [#"衛生.?認可" #"衛生.?監督" #"安全.?監督"]
   :blocked? true}]

 :phase-progression
 [{:phase 0
   :name "read-only"
   :auto-commit-operations #{}
   :description "All proposals held for human review"}

  {:phase 1
   :name "appointment + status-update"
   :auto-commit-operations #{:schedule-service-appointment :coordinate-service-status-update}
   :description "Appointment scheduling and status updates auto-commit"}

  {:phase 2
   :name "+ supply-coordination + shift-proposals"
   :auto-commit-operations #{:schedule-service-appointment
                              :coordinate-service-status-update
                              :coordinate-supply-request
                              :schedule-staff-shift-proposal}
   :description "All logistics (appointments, status, supply, shifts) auto-commit"}

  {:phase 3
   :name "auto-commit with escalation"
   :auto-commit-operations #{:schedule-service-appointment
                              :coordinate-service-status-update
                              :coordinate-supply-request
                              :schedule-staff-shift-proposal}
   :always-escalate-operations #{:flag-safety-concern}
   :description "All non-safety ops auto-commit, safety concerns always escalate"}]

 :audit-trail
 {:coordination-log "Append-only committed proposals"
  :ledger "Append-only immutable decision facts"}

 :no-clinical-authority "This actor has zero clinical judgment authority. All health, allergy, treatment, and safety-compliance decisions require qualified human review."}
